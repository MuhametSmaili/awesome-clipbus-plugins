{
  "name": "@clipbus/template-plugin",
  "private": true,
  "version": "0.2.0",
  "description": "Source-based template plugin for Clipbus: detectors, card pages and Actions on plugin protocol V2.",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "vite --host 127.0.0.1 --open /src/preview/preview-host/index.html",
    "build:runtime": "node ./scripts/build-runtime.mjs",
    "build:ui": "node ./scripts/build-ui.mjs",
    "verify:build": "node ./scripts/verify-build.mjs",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build:artifacts": "npm run clean && npm run build:runtime && npm run build:ui && npm run verify:build",
    "build": "npm run typecheck && npm run lint && npm run build:artifacts",
    "verify:manifest": "clipbus-validate-manifest .",
    "verify:manifest:runtime": "clipbus-validate-manifest . --runtime",
    "verify": "npm run verify:manifest && npm run build && npm run verify:manifest:runtime && npm test",
    "test": "node --test './tests/**/*.test.cjs'"
  },
  "dependencies": {
    "@clipbus/plugin-sdk": "^2.0.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^25.9.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@vitejs/plugin-vue": "^5.2.1",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^9.33.0",
    "vite": "^5.4.14",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.2.12"
  }
}
