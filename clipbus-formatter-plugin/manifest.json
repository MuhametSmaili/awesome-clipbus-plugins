{
  "schemaVersion": 5,
  "plugin": {
    "id": "plugin.formatter",
    "title": "Formatter",
    "version": "0.1.0"
  },
  "install": {
    "runtime": "node",
    "entry": "scripts/install.mjs"
  },
  "runtime": {
    "nodeEntry": "dist/plugin.cjs"
  },
  "detectors": [
    {
      "id": "json-detector",
      "title": "JSON Detector",
      "inputKinds": [
        "text"
      ]
    },
    {
      "id": "xml-detector",
      "title": "XML Detector",
      "inputKinds": [
        "text"
      ]
    },
    {
      "id": "csv-detector",
      "title": "CSV Detector",
      "inputKinds": [
        "text"
      ]
    }
  ],
  "actions": [],
  "renderers": [
    {
      "id": "json-renderer",
      "title": "JSON Formatter",
      "attachmentType": "plugin.formatter.json",
      "height": {
        "min": 160,
        "max": 480
      },
      "page": "dist/ui/renderers/json-renderer/index.html",
      "tint": "#7C3AED",
      "buttons": [
        {
          "id": "copy",
          "title": "Copy Pretty"
        }
      ]
    },
    {
      "id": "xml-renderer",
      "title": "XML Formatter",
      "attachmentType": "plugin.formatter.xml",
      "height": {
        "min": 140,
        "max": 480
      },
      "page": "dist/ui/renderers/xml-renderer/index.html",
      "tint": "#7C3AED",
      "buttons": [
        {
          "id": "copy-xml",
          "title": "Copy Formatted XML"
        }
      ]
    },
    {
      "id": "csv-table",
      "title": "CSV",
      "attachmentType": "plugin.formatter.csv",
      "height": {
        "min": 160,
        "max": 460
      },
      "page": "dist/ui/renderers/csv-table/index.html",
      "tint": "#0F766E",
      "buttons": [
        {
          "id": "copy",
          "title": "Copy as Markdown Table"
        }
      ]
    }
  ],
  "writes": {
    "attachmentTypes": [
      "plugin.formatter.json",
      "plugin.formatter.xml",
      "plugin.formatter.csv"
    ],
    "searchScopes": [
      "formatter",
      "xml",
      "csv"
    ]
  }
}
