{
  "schemaVersion": 5,
  "plugin": {
    "id": "plugin.preview",
    "title": "Preview",
    "version": "0.1.0"
  },
  "install": {
    "runtime": "node",
    "entry": "scripts/install.mjs"
  },
  "runtime": {
    "nodeEntry": "dist/plugin.cjs"
  },
  "detectors": [
    {
      "id": "color-detector",
      "title": "Color Detector",
      "inputKinds": [
        "text"
      ]
    },
    {
      "id": "markdown-detector",
      "title": "Markdown Detector",
      "inputKinds": [
        "text"
      ]
    },
    {
      "id": "gradient-detector",
      "title": "Gradient Detector",
      "inputKinds": [
        "text"
      ]
    }
  ],
  "actions": [],
  "renderers": [
    {
      "id": "color-swatch",
      "title": "Color",
      "attachmentType": "plugin.preview.color",
      "height": {
        "min": 260,
        "max": 260
      },
      "page": "dist/ui/renderers/color-swatch/index.html",
      "buttons": [
        {
          "id": "copy",
          "title": "Copy All Formats"
        }
      ]
    },
    {
      "id": "markdown-renderer",
      "title": "Markdown Preview",
      "attachmentType": "plugin.preview.markdown",
      "height": {
        "min": 120,
        "max": 480
      },
      "page": "dist/ui/renderers/markdown-renderer/index.html",
      "tint": "#0EA5E9"
    },
    {
      "id": "gradient-swatch",
      "title": "Gradient",
      "attachmentType": "plugin.preview.gradient",
      "height": {
        "min": 260,
        "max": 260
      },
      "page": "dist/ui/renderers/gradient-swatch/index.html",
      "buttons": [
        {
          "id": "copy-gradient",
          "title": "Copy Gradient"
        }
      ]
    }
  ],
  "writes": {
    "attachmentTypes": [
      "plugin.preview.color",
      "plugin.preview.markdown",
      "plugin.preview.gradient"
    ],
    "searchScopes": [
      "color",
      "markdown",
      "preview"
    ]
  }
}
