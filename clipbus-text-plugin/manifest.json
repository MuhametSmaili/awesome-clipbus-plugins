{
  "schemaVersion": 5,
  "plugin": {
    "id": "plugin.text",
    "title": "Text Tools",
    "version": "0.3.0"
  },
  "install": {
    "runtime": "node",
    "entry": "scripts/install.mjs"
  },
  "runtime": {
    "nodeEntry": "dist/plugin.cjs"
  },
  "detectors": [],
  "renderers": [],
  "actions": [
    {
      "id": "text-sort",
      "title": "Sort Lines",
      "inputKinds": ["text"],
      "keywords": ["sort", "order", "lines"]
    },
    {
      "id": "text-dedup",
      "title": "Remove Duplicate Lines",
      "inputKinds": ["text"],
      "keywords": ["dedup", "unique", "duplicates"]
    },
    {
      "id": "text-trim",
      "title": "Tidy Whitespace",
      "inputKinds": ["text"],
      "keywords": ["trim", "whitespace", "spaces"]
    },
    {
      "id": "text-strip-ansi",
      "title": "Strip ANSI Codes",
      "inputKinds": ["text"],
      "keywords": ["ansi", "escape", "terminal", "color", "strip"]
    },
    {
      "id": "text-reverse-lines",
      "title": "Reverse Lines",
      "inputKinds": ["text"],
      "keywords": ["reverse", "lines", "flip"]
    },
    {
      "id": "text-reverse-characters",
      "title": "Reverse Characters",
      "inputKinds": ["text"],
      "keywords": ["reverse", "characters", "text", "flip"]
    },
    {
      "id": "text-sort-characters",
      "title": "Sort Characters",
      "inputKinds": ["text"],
      "keywords": ["sort", "characters", "order"]
    },
    {
      "id": "text-pretty-json",
      "title": "Pretty JSON",
      "inputKinds": ["text"],
      "keywords": ["json", "pretty", "format", "indent"]
    },
    {
      "id": "text-minify-json",
      "title": "Minify JSON",
      "inputKinds": ["text"],
      "keywords": ["json", "minify", "compact"]
    }
  ],
  "writes": {
    "attachmentTypes": [],
    "searchScopes": []
  }
}
