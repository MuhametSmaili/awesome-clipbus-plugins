{
  "schemaVersion": 5,
  "plugin": {
    "id": "plugin.cron",
    "title": "Cron Explainer",
    "version": "0.1.0"
  },
  "install": {
    "runtime": "node",
    "entry": "scripts/install.mjs"
  },
  "runtime": {
    "nodeEntry": "dist/plugin.cjs"
  },
  "detectors": [
    {
      "id": "cron-detector",
      "title": "Cron Expression Detector",
      "inputKinds": [
        "text"
      ]
    }
  ],
  "actions": [],
  "renderers": [
    {
      "id": "cron-renderer",
      "title": "Cron Schedule",
      "attachmentType": "plugin.cron.schedule",
      "height": {
        "min": 120,
        "max": 560
      },
      "tint": "#B45309",
      "page": "dist/ui/renderers/cron-renderer/index.html"
    }
  ],
  "writes": {
    "attachmentTypes": [
      "plugin.cron.schedule"
    ],
    "searchScopes": [
      "cron"
    ]
  }
}
