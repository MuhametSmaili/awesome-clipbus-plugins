{
  "schemaVersion": 5,
  "plugin": {
    "id": "plugin.extractor",
    "title": "Extractor",
    "version": "0.1.0"
  },
  "install": {
    "runtime": "node",
    "entry": "scripts/install.mjs"
  },
  "runtime": {
    "nodeEntry": "dist/plugin.cjs"
  },
  "detectors": [
    {
      "id": "entities-detector",
      "title": "URL / Email / IP Detector",
      "inputKinds": [
        "text"
      ]
    },
    {
      "id": "url-detector",
      "title": "URL / Query String Detector",
      "inputKinds": [
        "text"
      ]
    },
    {
      "id": "ip-detector",
      "title": "IP Address Detector",
      "inputKinds": [
        "text"
      ]
    },
    {
      "id": "geo-detector",
      "title": "Coordinates Detector",
      "inputKinds": [
        "text"
      ]
    },
    {
      "id": "mac-detector",
      "title": "MAC Address Detector",
      "inputKinds": [
        "text"
      ]
    },
    {
      "id": "uuid-detector",
      "title": "UUID Detector",
      "inputKinds": [
        "text"
      ]
    }
  ],
  "actions": [],
  "renderers": [
    {
      "id": "entities-renderer",
      "title": "Extracted Entities",
      "attachmentType": "plugin.extractor.entities",
      "height": {
        "min": 140,
        "max": 420
      },
      "page": "dist/ui/renderers/entities-renderer/index.html",
      "tint": "#2563EB",
      "buttons": [
        {
          "id": "copy-all",
          "title": "Copy All"
        }
      ]
    },
    {
      "id": "url-parsed",
      "title": "URL Details",
      "attachmentType": "plugin.extractor.url",
      "height": {
        "min": 140,
        "max": 500
      },
      "page": "dist/ui/renderers/url-parsed/index.html",
      "tint": "#2563EB",
      "buttons": [
        {
          "id": "copy",
          "title": "Copy query params (JSON)"
        }
      ]
    },
    {
      "id": "ip-details",
      "title": "IP Address",
      "attachmentType": "plugin.extractor.ip",
      "height": {
        "min": 140,
        "max": 380
      },
      "page": "dist/ui/renderers/ip-details/index.html",
      "tint": "#0891B2",
      "buttons": [
        {
          "id": "copy-input",
          "title": "Copy IP"
        }
      ]
    },
    {
      "id": "geo-coordinates",
      "title": "Coordinates",
      "attachmentType": "plugin.extractor.geo",
      "height": {
        "min": 120,
        "max": 340
      },
      "page": "dist/ui/renderers/geo-coordinates/index.html",
      "tint": "#16A34A",
      "buttons": [
        {
          "id": "copy-decimal",
          "title": "Copy Coordinates"
        }
      ]
    },
    {
      "id": "mac-address",
      "title": "MAC Address",
      "attachmentType": "plugin.extractor.mac",
      "height": {
        "min": 120,
        "max": 320
      },
      "page": "dist/ui/renderers/mac-address/index.html",
      "tint": "#7C3AED",
      "buttons": [
        {
          "id": "copy-input",
          "title": "Copy MAC"
        }
      ]
    },
    {
      "id": "uuid-details",
      "title": "UUID",
      "attachmentType": "plugin.extractor.uuid",
      "height": {
        "min": 120,
        "max": 360
      },
      "page": "dist/ui/renderers/uuid-details/index.html",
      "tint": "#7C3AED",
      "buttons": [
        {
          "id": "copy-canonical",
          "title": "Copy UUID"
        }
      ]
    }
  ],
  "writes": {
    "attachmentTypes": [
      "plugin.extractor.entities",
      "plugin.extractor.url",
      "plugin.extractor.ip",
      "plugin.extractor.geo",
      "plugin.extractor.mac",
      "plugin.extractor.uuid"
    ],
    "searchScopes": [
      "extractor",
      "url",
      "query"
    ]
  }
}
