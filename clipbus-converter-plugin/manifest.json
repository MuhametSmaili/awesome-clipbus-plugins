{
  "schemaVersion": 5,
  "plugin": {
    "id": "plugin.converter",
    "title": "Converter",
    "version": "0.1.0"
  },
  "install": {
    "runtime": "node",
    "entry": "scripts/install.mjs"
  },
  "runtime": {
    "nodeEntry": "dist/plugin.cjs"
  },
  "detectors": [
    {
      "id": "timestamp-detector",
      "title": "Unix Timestamp Detector",
      "inputKinds": [
        "text"
      ]
    },
    {
      "id": "radix-detector",
      "title": "Radix Detector",
      "inputKinds": [
        "text"
      ]
    },
    {
      "id": "duration-detector",
      "title": "Duration Detector",
      "inputKinds": [
        "text"
      ]
    },
    {
      "id": "temperature-detector",
      "title": "Temperature Detector",
      "inputKinds": [
        "text"
      ]
    },
    {
      "id": "filesize-detector",
      "title": "Data Size Detector",
      "inputKinds": [
        "text"
      ]
    },
    {
      "id": "chmod-detector",
      "title": "File Permission Detector",
      "inputKinds": [
        "text"
      ]
    }
  ],
  "actions": [
    {
      "id": "uppercase",
      "title": "Uppercase",
      "keywords": [
        "uppercase",
        "upper",
        "case"
      ],
      "inputKinds": [
        "text"
      ]
    },
    {
      "id": "lowercase",
      "title": "Lowercase",
      "keywords": [
        "lowercase",
        "lower",
        "case"
      ],
      "inputKinds": [
        "text"
      ]
    },
    {
      "id": "camelCase",
      "title": "camelCase",
      "keywords": [
        "camel",
        "case",
        "naming"
      ],
      "inputKinds": [
        "text"
      ]
    },
    {
      "id": "pascalCase",
      "title": "PascalCase",
      "keywords": [
        "pascal",
        "case",
        "naming"
      ],
      "inputKinds": [
        "text"
      ]
    },
    {
      "id": "snakeCase",
      "title": "snake_case",
      "keywords": [
        "snake",
        "case",
        "naming"
      ],
      "inputKinds": [
        "text"
      ]
    },
    {
      "id": "kebabCase",
      "title": "kebab-case",
      "keywords": [
        "kebab",
        "case",
        "naming"
      ],
      "inputKinds": [
        "text"
      ]
    },
    {
      "id": "constantCase",
      "title": "CONSTANT_CASE",
      "keywords": [
        "constant",
        "case",
        "naming"
      ],
      "inputKinds": [
        "text"
      ]
    },
    {
      "id": "titleCase",
      "title": "Title Case",
      "keywords": [
        "title",
        "case",
        "naming"
      ],
      "inputKinds": [
        "text"
      ]
    },
    {
      "id": "sentenceCase",
      "title": "Sentence case",
      "keywords": [
        "sentence",
        "case",
        "naming"
      ],
      "inputKinds": [
        "text"
      ]
    },
    {
      "id": "dotCase",
      "title": "dot.case",
      "keywords": [
        "dot",
        "case",
        "naming"
      ],
      "inputKinds": [
        "text"
      ]
    }
  ],
  "renderers": [
    {
      "id": "timestamp-renderer",
      "title": "Unix Timestamp Converter",
      "attachmentType": "plugin.converter.timestamp",
      "height": {
        "min": 140,
        "max": 460
      },
      "tint": "#0F766E",
      "page": "dist/ui/renderers/timestamp-renderer/index.html",
      "buttons": [
        {
          "id": "copy-iso",
          "title": "Copy ISO 8601"
        }
      ]
    },
    {
      "id": "radix-renderer",
      "title": "Radix Converter",
      "attachmentType": "plugin.converter.radix",
      "height": {
        "min": 120,
        "max": 300
      },
      "tint": "#4F46E5",
      "page": "dist/ui/renderers/radix-renderer/index.html",
      "buttons": [
        {
          "id": "copy-all",
          "title": "Copy all radix"
        }
      ]
    },
    {
      "id": "duration",
      "title": "Duration",
      "attachmentType": "plugin.converter.duration",
      "height": {
        "min": 140,
        "max": 300
      },
      "tint": "#7C3AED",
      "page": "dist/ui/renderers/duration/index.html",
      "buttons": [
        {
          "id": "copy-seconds",
          "title": "Copy Seconds"
        }
      ]
    },
    {
      "id": "temperature",
      "title": "Temperature",
      "attachmentType": "plugin.converter.temperature",
      "height": {
        "min": 140,
        "max": 300
      },
      "tint": "#EF4444",
      "page": "dist/ui/renderers/temperature/index.html"
    },
    {
      "id": "filesize-renderer",
      "title": "Data Size",
      "attachmentType": "plugin.converter.filesize",
      "height": {
        "min": 180,
        "max": 420
      },
      "tint": "#0369A1",
      "page": "dist/ui/renderers/filesize-renderer/index.html"
    },
    {
      "id": "chmod-renderer",
      "title": "File Permissions",
      "attachmentType": "plugin.converter.chmod",
      "height": {
        "min": 180,
        "max": 380
      },
      "tint": "#475569",
      "page": "dist/ui/renderers/chmod-renderer/index.html"
    }
  ],
  "writes": {
    "attachmentTypes": [
      "plugin.converter.timestamp",
      "plugin.converter.radix",
      "plugin.converter.duration",
      "plugin.converter.temperature",
      "plugin.converter.filesize",
      "plugin.converter.chmod"
    ],
    "searchScopes": [
      "converter",
      "radix"
    ]
  }
}
