{
  "schemaVersion": 5,
  "plugin": {
    "id": "plugin.decoder",
    "title": "Decoder",
    "version": "0.1.0"
  },
  "install": {
    "runtime": "node",
    "entry": "scripts/install.mjs"
  },
  "runtime": {
    "nodeEntry": "dist/plugin.cjs"
  },
  "detectors": [
    {
      "id": "base64-detector",
      "title": "Base64 Detector",
      "inputKinds": [
        "text"
      ]
    },
    {
      "id": "jwt-detector",
      "title": "JWT Detector",
      "inputKinds": [
        "text"
      ]
    },
    {
      "id": "data-uri-detector",
      "title": "Data URI Detector",
      "inputKinds": [
        "text"
      ]
    }
  ],
  "actions": [
    {
      "id": "url-encode",
      "title": "URL Encode",
      "keywords": [
        "url",
        "percent",
        "encode",
        "escape"
      ],
      "inputKinds": [
        "text"
      ]
    },
    {
      "id": "url-decode",
      "title": "URL Decode",
      "keywords": [
        "url",
        "percent",
        "decode",
        "unescape"
      ],
      "inputKinds": [
        "text"
      ]
    },
    {
      "id": "html-encode",
      "title": "HTML Encode",
      "keywords": [
        "html",
        "entity",
        "encode",
        "escape"
      ],
      "inputKinds": [
        "text"
      ]
    },
    {
      "id": "html-decode",
      "title": "HTML Decode",
      "keywords": [
        "html",
        "entity",
        "decode",
        "unescape"
      ],
      "inputKinds": [
        "text"
      ]
    },
    {
      "id": "base64-encode",
      "title": "Base64 Encode",
      "keywords": [
        "base64",
        "encode"
      ],
      "inputKinds": [
        "text"
      ]
    },
    {
      "id": "base64-decode",
      "title": "Base64 Decode",
      "keywords": [
        "base64",
        "decode"
      ],
      "inputKinds": [
        "text"
      ]
    },
    {
      "id": "unicode-escape",
      "title": "Unicode Escape",
      "keywords": [
        "unicode",
        "escape",
        "encode"
      ],
      "inputKinds": [
        "text"
      ]
    },
    {
      "id": "unicode-unescape",
      "title": "Unicode Unescape",
      "keywords": [
        "unicode",
        "unescape",
        "decode"
      ],
      "inputKinds": [
        "text"
      ]
    },
    {
      "id": "json-escape",
      "title": "JSON Escape",
      "keywords": [
        "json",
        "escape",
        "encode"
      ],
      "inputKinds": [
        "text"
      ]
    },
    {
      "id": "json-unescape",
      "title": "JSON Unescape",
      "keywords": [
        "json",
        "unescape",
        "decode"
      ],
      "inputKinds": [
        "text"
      ]
    }
  ],
  "renderers": [
    {
      "id": "base64-renderer",
      "title": "Base64 Decode",
      "attachmentType": "plugin.decoder.base64",
      "height": {
        "min": 120,
        "max": 320
      },
      "page": "dist/ui/renderers/base64-renderer/index.html",
      "tint": "#0F766E",
      "buttons": [
        {
          "id": "copy",
          "title": "Copy Decoded Result"
        }
      ]
    },
    {
      "id": "jwt-renderer",
      "title": "JWT Decoded",
      "attachmentType": "plugin.decoder.jwt",
      "height": {
        "min": 140,
        "max": 440
      },
      "page": "dist/ui/renderers/jwt-renderer/index.html",
      "tint": "#7C3AED",
      "buttons": [
        {
          "id": "copy",
          "title": "Copy Payload"
        }
      ]
    },
    {
      "id": "data-uri",
      "title": "Data URI",
      "attachmentType": "plugin.decoder.datauri",
      "height": {
        "min": 120,
        "max": 320
      },
      "page": "dist/ui/renderers/data-uri/index.html",
      "tint": "#0369A1",
      "buttons": [
        {
          "id": "copy",
          "title": "Copy Decoded"
        }
      ]
    }
  ],
  "writes": {
    "attachmentTypes": [
      "plugin.decoder.base64",
      "plugin.decoder.jwt",
      "plugin.decoder.datauri"
    ],
    "searchScopes": [
      "decoder",
      "jwt"
    ]
  }
}
